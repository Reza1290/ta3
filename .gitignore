# Root Workspace Gitignore
# Ignore raw 3D volumetric data & large archives
data/raw/
data/toothfairy2/
data/custom/gpt-astra-labeled/
data/review/
data/DICOM*/
data/benchmark_eval/
data/masks/
*.mha
*.dcm
*.nii
*.nii.gz

# Whitelist labeled data, manifests, and README
!data/processed/
!data/manifests/
!data/custom/
!data/README.md

# Ignore model checkpoint weights & run outputs
weights/*
!weights/README.md
runners/outputs/
*.pth
*.pt

.venv*/
.pytest_cache/
__pycache__/
*.py[cod]
*.zip
*.log

# Ignore OS files
.DS_Store
Thumbs.db
